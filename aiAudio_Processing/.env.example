# Set these in your shell; this file is documentation, not automatically loaded.
MODEL_DIR=C:/path/to/Shellhacksclone/models/yamnet
LOCAL_DB_PATH=C:/path/to/Shellhacksclone/data/events.sqlite3
RETENTION_DAYS=1
# Required by the capture process and validated by the local service when set.
CAPTURE_TOKEN=change-me
# Optional: set both to enable ElevenLabs spoken alerts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
