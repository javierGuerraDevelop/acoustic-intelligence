# Documentation only: this file is NOT loaded automatically.
# Export these variables in the shell (or process manager) that starts the API.
# Relative paths are resolved from the directory where you start the service
# (normally aiAudio_Processing/).

# Required: directory containing the downloaded YAMNet saved_model.pb.
MODEL_DIR=./models/yamnet

# Local SQLite event store (the containing directory is created automatically).
LOCAL_DB_PATH=./data/events.sqlite3

# Local retention window in days; must be 1 or 7.
RETENTION_DAYS=1

# Optional: when set, POST /v1/audio/chunks and POST /v1/capture/heartbeat
# require "Authorization: Bearer <token>". Use the same value for radar_capture.
CAPTURE_TOKEN=change-me

# Optional: set the key and voice to enable ElevenLabs spoken alerts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
